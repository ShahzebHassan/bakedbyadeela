  "narrative": {
    "northStar": "The floral cake studio",
    "overview": "Original client photographs carry the identity, supported by soft pastel fields and expressive serif typography. The approved Olive & Mac reference informs the wide blush masthead and restrained editorial presentation; the website uses the text Baked By Adeela wordmark.\n\nThe system is spacious and mostly flat. Quiet controls and warm ink let the details of hand-piped flowers remain the focus. This document records the implementation in `dist/style.css` and `build.py`; the composition contract remains in `DIRECTION.md`.",
    "keyCharacteristics": [
      "Original photography and a typographic brand.",
      "Blush, lilac, sage and ivory surfaces.",
      "Serif headings, square imagery and fine rules."
    ],
    "rules": [],
    "dos": [
      "Do preserve original cake details and client photography.",
      "Do use the text Baked By Adeela wordmark on the website.",
      "Do retain visible keyboard focus and reduced-motion support.",
      "Do send enquiry actions to the single enquiry page."
    ],
    "donts": [
